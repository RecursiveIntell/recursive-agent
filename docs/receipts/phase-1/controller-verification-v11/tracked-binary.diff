+    hasher.update(canonical_receipt);
+    ContentDigest::from_hex(hasher.finalize().to_hex().to_string())
+        .map_err(|error| ContractError::Malformed(format!("chain digest: {error}")))
+        .map_err(LedgerError::Contract)
